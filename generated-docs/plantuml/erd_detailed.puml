  payment_method_data : BYTEA ENCRYPTED
  business_sub_label : VARCHAR(255)
  straight_through_algorithm : JSONB
  preprocessing_step_id : VARCHAR(64)
  error_reason : TEXT
  multiple_capture_count : SMALLINT
  connector_response_reference_id : VARCHAR(255)
  amount_capturable : BIGINT DEFAULT 0
  updated_by : VARCHAR(255)
  authentication_data : JSONB
  encoded_data : TEXT
  merchant_connector_id : VARCHAR(64) <<FK>>
  unified_code : VARCHAR(255)
  unified_message : TEXT
  net_amount : BIGINT
  external_three_ds_authentication_attempted : BOOLEAN
  authentication_connector : VARCHAR(64)
  authentication_id : VARCHAR(64)
  mandate_data : JSONB
  payment_method_billing_address_id : VARCHAR(64) <<FK>>
  fingerprint_id : VARCHAR(64)
  charge_id : VARCHAR(64)
  client_source : VARCHAR(64)
  client_version : VARCHAR(64)
  customer_acceptance : JSONB
  profile_id : VARCHAR(64) <<FK>>
  organization_id : VARCHAR(64) <<FK>>
  card_network : VARCHAR(64)
  --
  Indexes:
  - idx_attempt_payment (payment_id)
  - idx_attempt_merchant_connector (merchant_id, connector, created_at)
  - idx_connector_txn_id (connector_transaction_id) UNIQUE WHERE connector_transaction_id IS NOT NULL
  - idx_attempt_status (status)
  - idx_payment_method_id (payment_method_id)
  --
  Constraints:
  - CHECK (amount > 0)
  - CHECK (amount_to_capture <= amount)
  - CHECK (amount_capturable <= amount)
}

entity "refund" as refund {
