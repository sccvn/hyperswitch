' Main Payment Tables
entity "merchant_account" as merchant {
  * **merchant_id** : VARCHAR(64) <<PK>>
  --
  merchant_name : VARCHAR(255) NOT NULL
  api_key : VARCHAR(128) ENCRYPTED
  merchant_details : JSONB
  return_url : TEXT
  enable_payment_response_hash : BOOLEAN
  payment_response_hash_key : VARCHAR(255)
  redirect_to_merchant_with_http_post : BOOLEAN
