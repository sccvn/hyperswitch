  Indexes:
  - idx_customer_merchant_email (merchant_id, email) UNIQUE
  - idx_customer_metadata (metadata) USING GIN
}

entity "payment_methods" as payment_methods {
  * **payment_method_id** : VARCHAR(64) <<PK>>
