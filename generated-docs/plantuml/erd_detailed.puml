  parent_merchant_id : VARCHAR(64) <<FK>>
  publishable_key : VARCHAR(255)
  storage_scheme : storage_scheme_enum
  locker_id : VARCHAR(64)
  metadata : JSONB
  routing_algorithm : JSONB
  primary_business_details : JSONB
  created_at : TIMESTAMP DEFAULT NOW()
  modified_at : TIMESTAMP DEFAULT NOW()
  frm_routing_algorithm : JSONB
  payout_routing_algorithm : JSONB
  default_profile : VARCHAR(64) <<FK>>
  payment_link_config : JSONB
  pm_collect_link_config : JSONB
  --
  Indexes:
  - idx_merchant_name
  - idx_parent_merchant
  - idx_publishable_key UNIQUE
