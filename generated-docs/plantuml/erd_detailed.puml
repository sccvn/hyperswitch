  internal_reference_id : VARCHAR(64) UNIQUE NOT NULL
  payment_id : VARCHAR(64) <<FK>> NOT NULL
  merchant_id : VARCHAR(64) <<FK>> NOT NULL
  connector_transaction_id : VARCHAR(255) NOT NULL
  connector : VARCHAR(64) NOT NULL
  connector_refund_id : VARCHAR(255)
  external_reference_id : VARCHAR(255)
  refund_type : refund_type_enum NOT NULL
  total_amount : BIGINT NOT NULL
  currency : currency_enum NOT NULL
  refund_amount : BIGINT NOT NULL
  refund_status : refund_status_enum NOT NULL
  sent_to_gateway : BOOLEAN DEFAULT FALSE
  refund_error_message : TEXT
  refund_error_code : VARCHAR(255)
  metadata : JSONB
  refund_arn : VARCHAR(255)
  created_at : TIMESTAMP DEFAULT NOW()
  modified_at : TIMESTAMP DEFAULT NOW()
  description : TEXT
  attempt_id : VARCHAR(64) <<FK>> NOT NULL
  refund_reason : TEXT
  refund_error_reason : TEXT
  profile_id : VARCHAR(64) <<FK>>
  updated_by : VARCHAR(255)
  merchant_connector_id : VARCHAR(64) <<FK>>
